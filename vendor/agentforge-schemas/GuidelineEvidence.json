{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "section": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "snippet": {
      "type": "string",
      "minLength": 1
    },
    "sparse_score": {
      "type": "number"
    },
    "dense_score": {
      "type": "number"
    },
    "rerank_score": {
      "type": "number"
    },
    "matched_terms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "degraded": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "sparse_only",
            "stub",
            "no_rerank"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "citation": {
      "type": "object",
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "document",
            "guideline",
            "openemr_record",
            "synthetic_chart_fixture"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "page_or_section": {
          "type": "string",
          "minLength": 1
        },
        "field_or_chunk_id": {
          "type": "string",
          "minLength": 1
        },
        "quote_or_value": {
          "type": "string",
          "minLength": 1
        },
        "bounding_box": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "coordinate_space": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_type",
        "source_id",
        "page_or_section",
        "field_or_chunk_id",
        "quote_or_value"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "title",
    "section",
    "version",
    "url",
    "publisher",
    "snippet",
    "sparse_score",
    "dense_score",
    "rerank_score",
    "matched_terms",
    "degraded",
    "citation"
  ],
  "additionalProperties": false,
  "title": "GuidelineEvidence"
}
