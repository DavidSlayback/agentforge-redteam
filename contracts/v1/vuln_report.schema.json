{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentforge-redteam/contracts/v1/vuln_report.schema.json",
  "title": "VulnReport (v1)",
  "description": "Documentation agent -> approval gate. A reproducible write-up of a Finding. Critical/high reports are held (status pending_approval) until a human approves.",
  "type": "object",
  "required": ["schema_version", "report_id", "finding_id", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "report_id": {"type": "string"},
    "finding_id": {"type": "string"},
    "severity": {"description": "carried from the finding"},
    "description": {"type": "string"},
    "clinical_impact": {"type": "string"},
    "repro": {
      "type": "object",
      "description": "enough to reproduce without the discoverer present",
      "properties": {
        "verdict_ids": {"type": "array", "items": {"type": "string"}},
        "minimal_spec_id": {"type": "string"},
        "steps_ref": {"type": "string"},
        "exchanges": {"type": "array"}
      },
      "additionalProperties": true
    },
    "observed_vs_expected": {"type": "string"},
    "remediation": {"type": "string"},
    "status": {"type": "string", "enum": ["draft", "pending_approval", "published"]},
    "fix_validation": {"type": ["object", "null"]},
    "approval": {
      "type": ["object", "null"],
      "properties": {
        "required": {"type": "boolean"},
        "approver": {"type": ["string", "null"]},
        "at": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
